        {
            "id": "rule_2",
            "conditions": {
                "Percussion Test": "Positive",
                "Radiographic Periapical Findings": "Radiolucency"
            },
            "diagnosis": "Symptomatic Apical Periodontitis",
            "description": "If percussion is positive and there is a radiographic radiolucency (and no swelling), the diagnosis is Symptomatic Apical Periodontitis."
        },
        {
            "id": "rule_3",
            "conditions": {
                "Percussion Test": "Negative",
                "Radiographic Periapical Findings": "Normal"
            },
            "diagnosis": "Normal Apical Tissues",
            "description": "If percussion is negative, radiographic findings are normal, and there is no swelling, the periapical tissues are normal."
        },
        {
            "id": "rule_fallback",
            "conditions": {},
            "diagnosis": "Asymptomatic Apical Periodontitis",
            "description": "If conditions do not perfectly match the above rules (e.g., negative percussion but a radiolucency is present), the diagnosis defaults to Asymptomatic Apical Periodontitis."
